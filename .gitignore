# Python junk files (created automatically, we don't need them in Git)
__pycache__/
*.pyc
*.pyo

# Virtual environment folder (contains thousands of library files — too big for Git)
venv/
.venv/
env/

# Data files (raw downloads can be large; we'll re-download them as needed)
data/

# Output files (these are generated by our code, not written by hand)
outputs/

# Secrets and environment variables (never commit passwords or API keys)
.env

# VS Code settings (personal to your machine, not part of the project)
.vscode/

# Mac junk files (not relevant on Windows but good practice)
.DS_Store
